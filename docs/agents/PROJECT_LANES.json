{
  "schema_version": 1,
  "repository": "blakinio/otclient",
  "default_lane": "otclient",
  "task_globs": [
    "docs/agents/tasks/active/*.md",
    "docs/agents/tasks/*.md"
  ],
  "execution": {
    "checkpoint_interval_minutes": 30,
    "lease_minutes": 45,
    "stale_after_minutes": 45,
    "barrier_mode": "wave",
    "max_interactive_interruptions": 0
  },
  "lanes": [
    {
      "id": "otclient-v2",
      "label": "OTClient v2 project",
      "task_prefixes": [
        "OTC2"
      ],
      "match_keywords": [
        "otclient-v2",
        "otclient v2",
        "client v2",
        "v2 project"
      ]
    },
    {
      "id": "otclient",
      "label": "OTClient project",
      "task_prefixes": [
        "OTC"
      ]
    }
  ]
}

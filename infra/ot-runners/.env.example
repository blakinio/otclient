# Fine-grained PAT recommended. Grant only the two target repositories and the
# minimum repository Administration permission required by the self-hosted
# runner registration/remove-token endpoints. Never commit the real token.
GITHUB_RUNNER_PAT=github_pat_REPLACE_ME

OTCLIENT_RUNNER_NAME=synology-otclient-01
OTS_RUNNER_NAME=synology-ots-01

Module
  name: client_assets
  description: Downloads missing client assets by client version
  author: OTClient team
  website: https://github.com/opentibiabr/otclient
  sandboxed: true
  scripts: [ client_assets, client_assets_release_selector, client_assets_release_adapter ]
  @onLoad: ClientAssetsReleaseAdapter.init()
  @onUnload: ClientAssetsReleaseAdapter.terminate()

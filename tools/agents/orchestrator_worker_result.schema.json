{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blakinio/otclient/tools/agents/orchestrator_worker_result.schema.json",
  "title": "OTClient Agent Orchestrator Worker Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "branch",
    "base_sha",
    "head_sha",
    "status",
    "changed_paths",
    "validation",
    "evidence",
    "context",
    "next_action"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "status": {"enum": ["completed", "ready", "waiting", "blocked"]},
    "changed_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "evidence"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pressure", "growth", "score", "provider_remaining_ratio"],
      "properties": {
        "pressure": {"enum": ["low", "medium", "high", "unbounded"]},
        "growth": {"enum": ["falling", "stable", "rising", "rapid", "unknown"]},
        "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 15},
        "provider_remaining_ratio": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "next_action": {"type": "string"}
  }
}
